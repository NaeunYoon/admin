@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <button class="btn btn-outline-secondary btn-sm" @onclick="PrevMonth">◀</button>
            <h4 class="mb-0">@month.ToString("yyyy년 M월")</h4>
            <button class="btn btn-outline-secondary btn-sm" @onclick="NextMonth">▶</button>
        </div>

        <div class="cal-grid">
            @foreach (var dow in new[] { "일", "월", "화", "수", "목", "금", "토" })
            {
                <div class="cal-dow @(dow == "일" ? "text-danger" : dow == "토" ? "text-primary" : "")">@dow</div>
            }

            @foreach (var day in days)
            {
                <div class="cal-cell @(day.InMonth ? "" : "cal-out") @(day.IsToday ? "cal-today" : "")"
                     @onclick="() => OnDayClick(day.Date)">
                    <div class="cal-daynum @(day.IsToday ? "cal-daynum-today" : "") @(day.Date.DayOfWeek == DayOfWeek.Sunday ? "text-danger" : day.Date.DayOfWeek == DayOfWeek.Saturday ? "text-primary" : "")">
                        @day.Date.Day
                    </div>
                    @foreach (var ev in EventsOn(day.Date))
                    {
                        <div class="cal-item bg-purple" title="@ev.Title">🎉 @ev.Title</div>
                    }
                    @foreach (var lv in LeavesOn(day.Date))
                    {
                        <div class="cal-item @LeaveClass(lv.LeaveType)" title="@lv.UserName @lv.LeaveType">
                            @lv.UserName @LeaveShort(lv.LeaveType)
                        </div>
                    }
                </div>
            }
        </div>

        <div class="d-flex flex-wrap gap-2 mt-3 small">
            <span class="badge bg-primary">연차</span>
            <span class="badge bg-info text-dark">반차/반반차</span>
            <span class="badge bg-warning text-dark">병가</span>
            <span class="badge bg-success">포상</span>
            <span class="badge bg-purple">사내행사</span>
        </div>
    </div>
</div>

@* ---------- 사내 일정 모달 (조회: 전원 / 등록·삭제: 관리자) ---------- *@
@if (selectedDate != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" @onclick="CloseDay">
        <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down modal-dialog-scrollable" @onclick:stopPropagation="true" @onclick="NoOp">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">사내 일정 — @selectedDate.Value.ToString("yyyy-MM-dd")</h5>
                    <button type="button" class="btn-close" @onclick="CloseDay"></button>
                </div>
                <div class="modal-body">
                    @* ----- 이 날 휴가 현황 (관리자/직원만) ----- *@
                    @{
                        var dayLeaves = LeavesOn(selectedDate.Value).ToList();
                    }
                    @if (dayLeaves.Any())
                    {
                        <h6 class="text-muted small mb-2">이 날 휴가/병가</h6>
                        <div class="mb-3">
                            @foreach (var lv in dayLeaves)
                            {
                                <span class="badge me-1 mb-1 @LeaveClass(lv.LeaveType)">@lv.UserName · @lv.LeaveType</span>
                            }
                        </div>
                    }

                    @* ----- 이 날의 일정 ----- *@
                    <h6 class="text-muted small mb-2">사내 일정</h6>
                    @if (dayEvents.Count == 0)
                    {
                        <p class="text-muted mb-3 small">등록된 일정이 없습니다.</p>
                    }
                    else
                    {
                        @foreach (var e in dayEvents)
                        {
                            <div class="border rounded p-2 mb-2">
                                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                    <div class="flex-grow-1" style="min-width:0;">
                                        <span class="fw-bold">🎉 @e.Title</span>
                                        <span class="badge bg-purple ms-1">@e.Category</span>
                                    </div>
                                    @if (isAdmin)
                                    {
                                        <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => DeleteEvent(e)">삭제</button>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(e.Description))
                                {
                                    <div class="mt-2 small" style="white-space: pre-wrap; word-break: break-all;">@e.Description</div>
                                }
                            </div>
                        }
                    }

                    @* ----- 등록 폼 (관리자 전용) ----- *@
                    @if (isAdmin && eventEditing != null)
                    {
                        <hr />
                        <h6 class="text-muted">일정 추가</h6>
                        <div class="mb-2">
                            <label class="form-label">분류</label>
                            <select class="form-select" @bind="eventEditing.Category">
                                <option value="회식">회식</option>
                                <option value="기념일">기념일</option>
                                <option value="행사">행사</option>
                                <option value="기타">기타</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">제목</label>
                            <input class="form-control" placeholder="예: 5월 전체 회식" @bind="eventEditing.Title" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">설명</label>
                            <textarea class="form-control" rows="2" @bind="eventEditing.Description"></textarea>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDay">닫기</button>
                    @if (isAdmin)
                    {
                        <button class="btn btn-primary" @onclick="SaveEvent">행사 추가</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
    .cal-dow { text-align: center; font-weight: 600; padding: 4px 0; }
    .cal-cell { min-height: 90px; border: 1px solid #eee; border-radius: 6px; padding: 4px; cursor: pointer; overflow: hidden; background: #fff; }
    .cal-cell:hover { background: #f8f9fa; }
    .cal-out { background: #f5f5f5; color: #bbb; }
    .cal-today {
        border: 2px solid #0d6efd;
        background: #e7f1ff;
        box-shadow: 0 0 0 1px #0d6efd inset;
    }
    .cal-today:hover { background: #d6e6ff; }
    .cal-daynum { font-size: 0.85rem; font-weight: 600; margin-bottom: 2px; }
    .cal-daynum-today {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px; height: 22px;
        background: #0d6efd;
        color: #fff !important;
        border-radius: 50%;
        font-weight: 700;
    }
    .cal-item { font-size: 0.7rem; border-radius: 4px; padding: 1px 4px; margin-bottom: 2px; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bg-purple { background-color: #6f42c1 !important; color: #fff; }
    @@media (max-width: 576px) {
        .cal-cell { min-height: 64px; }
        .cal-item { font-size: 0.6rem; }
    }
</style>

@code {
    // 컨테이너가 UTC라도 한국 사용자 기준의 "오늘"을 쓰도록 KST(UTC+9)로 계산
    private static DateOnly TodayKst() => DateOnly.FromDateTime(DateTime.UtcNow.AddHours(9));

    private DateOnly month = new(TodayKst().Year, TodayKst().Month, 1);
    private List<DayCell> days = new();
    private List<CompanyEvent> events = new();
    private List<LeaveRequest> leaves = new();

    private bool isAdmin;
    private bool isGuest;
    private string? userId;

    private DateOnly? selectedDate;
    private CompanyEvent? eventEditing;
    private List<CompanyEvent> dayEvents = new();

    private record DayCell(DateOnly Date, bool InMonth, bool IsToday);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        isAdmin = principal.IsInRole("Admin");
        isGuest = principal.IsInRole("Guest") && !principal.IsInRole("Admin") && !principal.IsInRole("Employee");
        userId = principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadMonth();
    }

    private async Task LoadMonth()
    {
        var first = month;
        var last = month.AddMonths(1).AddDays(-1);

        await using var db = await DbFactory.CreateDbContextAsync();

        events = await db.CompanyEvents.AsNoTracking()
            .Where(e => e.Date >= first && e.Date <= last)
            .ToListAsync();

        // 휴가/반차 정보는 협력사도 사내 일정 파악 위해 열람 가능
        leaves = await db.LeaveRequests.AsNoTracking()
            .Where(l => l.Status == "승인" && l.StartDate <= last && l.EndDate >= first)
            .ToListAsync();

        BuildGrid();
    }

    private void BuildGrid()
    {
        days.Clear();
        var first = month;
        var startOffset = (int)first.DayOfWeek; // 일=0
        var gridStart = first.AddDays(-startOffset);
        var today = TodayKst();

        for (int i = 0; i < 42; i++)
        {
            var d = gridStart.AddDays(i);
            days.Add(new DayCell(d, d.Month == month.Month, d == today));
        }
    }

    private IEnumerable<CompanyEvent> EventsOn(DateOnly d) => events.Where(e => e.Date == d);
    private IEnumerable<LeaveRequest> LeavesOn(DateOnly d) => leaves.Where(l => l.StartDate <= d && l.EndDate >= d);

    private static string LeaveClass(string type) => type switch
    {
        "연차" => "bg-primary",
        "반차" or "반반차" => "bg-info text-dark",
        "병가" => "bg-warning text-dark",
        "포상휴가" => "bg-success",
        _ => "bg-secondary"
    };

    private static string LeaveShort(string type) => type switch
    {
        "연차" => "연차",
        "반차" => "반차",
        "반반차" => "반반차",
        "병가" => "병가",
        "포상휴가" => "포상",
        _ => type
    };

    private async Task PrevMonth() { month = month.AddMonths(-1); await LoadMonth(); }
    private async Task NextMonth() { month = month.AddMonths(1); await LoadMonth(); }

    private void OnDayClick(DateOnly date)
    {
        // 조회는 전원, 등록은 관리자만
        selectedDate = date;
        dayEvents = events.Where(e => e.Date == date).ToList();
        eventEditing = isAdmin ? new CompanyEvent { Date = date, Category = "회식" } : null;
    }

    private void CloseDay()
    {
        selectedDate = null;
        eventEditing = null;
    }

    private void NoOp() { }

    private async Task SaveEvent()
    {
        if (!isAdmin || eventEditing == null || string.IsNullOrWhiteSpace(eventEditing.Title)) return;
        eventEditing.CreatedById = userId;
        eventEditing.CreatedAt = DateTime.UtcNow;

        var date = eventEditing.Date;
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.CompanyEvents.Add(eventEditing);
            await db.SaveChangesAsync();
        }

        await LoadMonth();
        dayEvents = events.Where(e => e.Date == date).ToList();
        // 추가 등록을 위해 폼 초기화
        eventEditing = new CompanyEvent { Date = date, Category = "회식" };
    }

    private async Task DeleteEvent(CompanyEvent e)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var target = await db.CompanyEvents.FindAsync(e.Id);
            if (target != null)
            {
                db.CompanyEvents.Remove(target);
                await db.SaveChangesAsync();
            }
        }
        await LoadMonth();
        dayEvents = events.Where(x => x.Date == e.Date).ToList();
    }
}
