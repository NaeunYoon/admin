@page "/supplies"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject AdminApp.Services.EditableTextService Texts
@inject AdminApp.Services.PushNotificationService Push
@inject IJSRuntime JS
@using Microsoft.EntityFrameworkCore
@using AdminApp.Data

<PageTitle>비품 / 간식 요청</PageTitle>

<div class="container-fluid py-3">
    <h2 class="fs-4 mb-3">@Texts.Get("supplies.page.title")</h2>

    <div class="row g-3">
        @* 왼쪽: 비품 요청 *@
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0 fs-5">@Texts.Get("supplies.items.title")</h4>
                        <button class="btn btn-outline-primary btn-sm" @onclick='() => OpenSupply("비품")'>+ 요청하기</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>신청일</th><th>신청자</th><th>품목</th><th>수량</th><th>상태</th></tr>
                            </thead>
                            <tbody>
                                @if (SuppliesOf("비품").Count == 0)
                                {
                                    <tr><td colspan="5" class="text-center text-muted">요청 내역이 없습니다.</td></tr>
                                }
                                else
                                {
                                    @foreach (var s in SuppliesOf("비품"))
                                    {
                                        <tr style="cursor:pointer;" @onclick="() => OpenDetail(s)">
                                            <td><small>@s.CreatedAt.ToLocalTime().ToString("MM-dd")</small></td>
                                            <td>@s.UserName</td>
                                            <td>@s.ItemName</td>
                                            <td>@s.Quantity</td>
                                            <td><span class="badge @StatusClass(s.Status)">@s.Status</span></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        @* 오른쪽: 간식 요청 *@
        <div class="col-12 col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0 fs-5">@Texts.Get("supplies.snacks.title")</h4>
                        <button class="btn btn-outline-primary btn-sm" @onclick='() => OpenSupply("간식")'>+ 요청하기</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr><th>신청일</th><th>신청자</th><th>품목</th><th>수량</th><th>상태</th></tr>
                            </thead>
                            <tbody>
                                @if (SuppliesOf("간식").Count == 0)
                                {
                                    <tr><td colspan="5" class="text-center text-muted">요청 내역이 없습니다.</td></tr>
                                }
                                else
                                {
                                    @foreach (var s in SuppliesOf("간식"))
                                    {
                                        <tr style="cursor:pointer;" @onclick="() => OpenDetail(s)">
                                            <td><small>@s.CreatedAt.ToLocalTime().ToString("MM-dd")</small></td>
                                            <td>@s.UserName</td>
                                            <td>@s.ItemName</td>
                                            <td>@s.Quantity</td>
                                            <td><span class="badge @StatusClass(s.Status)">@s.Status</span></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ---------- 요청 작성 모달 ---------- *@
@if (supplyEditing != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1"
         @onclick="CloseEditing">
        <div class="modal-dialog modal-dialog-centered"
             @onclick:stopPropagation="true" @onclick="NoOp">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@supplyEditing.Category 요청</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditing"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">분류</label>
                        <select class="form-select" @bind="supplyEditing.Category">
                            <option value="비품">비품</option>
                            <option value="간식">간식</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">품목 <span class="text-danger">*</span></label>
                        <input class="form-control" placeholder="예: A4용지, 새우깡, 컵라면 등 자유 입력"
                               @bind="supplyEditing.ItemName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">수량</label>
                        <input type="number" min="1" class="form-control" @bind="supplyEditing.Quantity" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label">메모 <small class="text-muted">(쿠팡 등 구매 링크 첨부 가능)</small></label>
                        <textarea class="form-control" rows="3"
                                  placeholder="예: https://www.coupang.com/vp/products/..."
                                  @bind="supplyEditing.Note"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseEditing">취소</button>
                    <button class="btn btn-primary" @onclick="SaveSupply">요청</button>
                </div>
            </div>
        </div>
    </div>
}

@* ---------- 요청 상세 모달 ---------- *@
@if (supplyDetail != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1"
         @onclick="CloseDetail">
        <div class="modal-dialog modal-dialog-centered"
             @onclick:stopPropagation="true" @onclick="NoOp">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@supplyDetail.Category 요청 상세</h5>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    <dl class="row mb-0 small">
                        <dt class="col-4 text-muted">신청일</dt>
                        <dd class="col-8">@supplyDetail.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
                        <dt class="col-4 text-muted">신청자</dt>
                        <dd class="col-8">@supplyDetail.UserName</dd>
                        <dt class="col-4 text-muted">분류</dt>
                        <dd class="col-8">@supplyDetail.Category</dd>
                        <dt class="col-4 text-muted">품목</dt>
                        <dd class="col-8"><strong>@supplyDetail.ItemName</strong></dd>
                        <dt class="col-4 text-muted">수량</dt>
                        <dd class="col-8">@supplyDetail.Quantity</dd>
                        <dt class="col-4 text-muted">상태</dt>
                        <dd class="col-8"><span class="badge @StatusClass(supplyDetail.Status)">@supplyDetail.Status</span></dd>
                    </dl>
                    <hr />
                    <div>
                        <label class="form-label d-flex justify-content-between align-items-center">
                            <span>메모</span>
                            @if (!string.IsNullOrEmpty(supplyDetail.Note))
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => Copy(supplyDetail.Note!)">
                                    📋 복사
                                </button>
                            }
                        </label>
                        @if (string.IsNullOrEmpty(supplyDetail.Note))
                        {
                            <div class="text-muted small">메모 없음</div>
                        }
                        else
                        {
                            <div class="border rounded p-2 bg-light small" style="word-break: break-all; white-space: pre-wrap;">@supplyDetail.Note</div>
                            @if (LooksLikeUrl(supplyDetail.Note))
                            {
                                <a href="@supplyDetail.Note" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary mt-2">
                                    🔗 링크 열기
                                </a>
                            }
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(copyMessage))
                    {
                        <div class="alert alert-success py-1 mt-2 mb-0 small">@copyMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDetail">닫기</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<SupplyRequest>? supplies;
    private SupplyRequest? supplyEditing;
    private SupplyRequest? supplyDetail;
    private string? currentUserId;
    private string? currentUserName;
    private string? copyMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        currentUserId = principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        currentUserName = principal.FindFirst("KoreanName")?.Value ?? principal.Identity?.Name;
        await LoadSupplies();
    }

    private async Task LoadSupplies()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        supplies = await db.SupplyRequests.AsNoTracking()
            .OrderByDescending(s => s.CreatedAt)
            .Take(100)
            .ToListAsync();
    }

    private List<SupplyRequest> SuppliesOf(string category) =>
        (supplies ?? new()).Where(s => s.Category == category).ToList();

    private static string StatusClass(string status) => status switch
    {
        "승인" => "bg-success",
        "완료" => "bg-primary",
        "반려" => "bg-danger",
        _ => "bg-secondary"
    };

    private void OpenSupply(string category) =>
        supplyEditing = new SupplyRequest { Quantity = 1, Category = category };

    private void CloseEditing() => supplyEditing = null;

    private void OpenDetail(SupplyRequest s)
    {
        supplyDetail = s;
        copyMessage = null;
    }

    private void CloseDetail()
    {
        supplyDetail = null;
        copyMessage = null;
    }

    private void NoOp() { /* propagation 차단 전용 */ }

    private async Task Copy(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            copyMessage = "✅ 메모가 클립보드에 복사되었어요";
        }
        catch
        {
            copyMessage = "복사에 실패했어요. 직접 선택해서 복사해주세요.";
        }
    }

    private static bool LooksLikeUrl(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return false;
        var t = text.Trim();
        return t.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || t.StartsWith("https://", StringComparison.OrdinalIgnoreCase);
    }

    private async Task SaveSupply()
    {
        if (supplyEditing == null || string.IsNullOrWhiteSpace(supplyEditing.ItemName)) return;
        supplyEditing.UserId = currentUserId ?? "";
        supplyEditing.UserName = currentUserName;
        supplyEditing.Status = "대기";
        supplyEditing.CreatedAt = DateTime.UtcNow;

        // 알림용 정보 캡처 (저장 후 supplyEditing은 null 처리되므로)
        var cat = supplyEditing.Category;
        var item = supplyEditing.ItemName;
        var qty = supplyEditing.Quantity;

        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.SupplyRequests.Add(supplyEditing);
            await db.SaveChangesAsync();
        }
        supplyEditing = null;
        await LoadSupplies();

        // 관리자에게 알림 (인박스 + 푸시)
        _ = Push.SendToAdminsAsync(
            $"새 {cat} 요청",
            $"{currentUserName} · {item} ×{qty}",
            "/admin/requests",
            "비품");
    }
}
