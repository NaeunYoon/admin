    private void OpenGrant()
    {
        granting = true;
        grantUserId = "";
        grantAmount = 0;
        grantReason = "";
        grantMsg = null;
    }

    private async Task GrantReward()
    {
        grantMsg = null;
        if (string.IsNullOrEmpty(grantUserId)) { grantMsg = "대상 직원을 선택해주세요."; return; }
        if (grantAmount <= 0) { grantMsg = "포상 일수를 입력해주세요."; return; }

        var u = await UserManager.FindByIdAsync(grantUserId);
        if (u == null) { grantMsg = "직원을 찾을 수 없습니다."; return; }

        var rec = new RewardRecord
        {
            UserId = u.Id,
            UserName = u.KoreanName ?? u.Email,
            Amount = grantAmount,
            Reason = string.IsNullOrWhiteSpace(grantReason) ? "관리자 부여" : grantReason,
            Source = "관리자부여",
            Status = "승인",
            ApprovedById = adminId,
            ApprovedByName = adminName,
            ApprovedAt = DateTime.UtcNow,
            CreatedAt = DateTime.UtcNow
        };
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            db.RewardRecords.Add(rec);
            await db.SaveChangesAsync();
        }

        u.RewardLeave += grantAmount;
        u.UpdatedAt = DateTime.UtcNow;
        await UserManager.UpdateAsync(u);

        granting = false;
        await LoadAll();
    }

    private static MarkupString StatusBadge(string status)
    {
        var cls = status switch
        {
            "승인" => "bg-success",
            "완료" => "bg-primary",
            "반려" => "bg-danger",
            "승인취소" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
        return new MarkupString($"<span class=\"badge {cls}\">{status}</span>");
    }
