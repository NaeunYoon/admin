@page "/admin/requests"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject AdminApp.Services.PushNotificationService Push

<PageTitle>신청 관리</PageTitle>

<div class="container-fluid py-3">
    <h2 class="mb-3">신청 관리</h2>

    <div class="tabs-scroll mb-3">
        <ul class="nav nav-tabs flex-nowrap">
            <li class="nav-item text-nowrap"><button class="nav-link @(tab == "leave" ? "active" : "")" @onclick='() => tab = "leave"'>휴가 (@leaves?.Count(l => l.Status == "대기"))</button></li>
            <li class="nav-item text-nowrap"><button class="nav-link @(tab == "reward" ? "active" : "")" @onclick='() => tab = "reward"'>포상 (@rewards?.Count(r => r.Status == "대기"))</button></li>
            <li class="nav-item text-nowrap"><button class="nav-link @(tab == "supply" ? "active" : "")" @onclick='() => tab = "supply"'>비품/간식 (@supplies?.Count(s => s.Status == "대기"))</button></li>
            <li class="nav-item text-nowrap"><button class="nav-link @(tab == "reverts" ? "active" : "")" @onclick='() => tab = "reverts"'>승인취소 (@reverts?.Count)</button></li>
        </ul>
    </div>

<style>
    .tabs-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .tabs-scroll .nav-tabs { border-bottom: 1px solid #dee2e6; min-width: max-content; }

    /* 모바일: 신청 관리 표를 카드 형태로 (가로 스크롤 없이 화면 너비에 맞춤) */
    @@media (max-width: 768px) {
        .req-scroll { overflow-x: visible !important; }
        .req-table { border: none; width: 100%; min-width: 0; }
        .req-table thead { display: none; }
        .req-table tbody tr {
            display: block;
            border: 1px solid #e3e6ea;
            border-radius: 12px;
            padding: 10px 14px;
            margin-bottom: 12px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            background: #fff;
        }
        .req-table tbody td {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            padding: 5px 0;
            border: none;
            text-align: right;
            font-size: 0.9rem;
            word-break: break-word;
            overflow-wrap: anywhere;
            min-width: 0;
        }
        .req-table tbody td::before {
            content: attr(data-label);
            font-weight: 600;
            color: #6c757d;
            text-align: left;
            flex-shrink: 0;
            font-size: 0.82rem;
            white-space: nowrap;
        }
        /* 값 영역이 줄바꿈되도록 */
        .req-table tbody td > * { min-width: 0; }
        /* 신청자/대상자 행은 카드 헤더처럼 강조 */
        .req-table tbody td[data-label="신청자"],
        .req-table tbody td[data-label="대상자"] {
            border-bottom: 1px solid #f0f0f0;
            padding-bottom: 8px;
            margin-bottom: 4px;
            font-size: 1.05rem;
            align-items: center;
        }
        /* 처리 버튼 행은 오른쪽 정렬 */
        .req-table tbody td[data-label="처리"] { padding-top: 8px; justify-content: flex-end; }
        .req-table tbody td[data-label="처리"]::before { align-self: center; }
        /* "항목 없음" 행은 라벨 숨김 */
        .req-table tbody td[colspan]::before { content: ""; }
        .req-table tbody td[colspan] { justify-content: center; text-align: center; }
    }
</style>

    @* ---------- 휴가 ---------- *@
    @if (tab == "leave")
    {
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="pendL" @bind="showPendingOnly" />
            <label class="form-check-label" for="pendL">대기 항목만 보기</label>
        </div>
        <div class="table-responsive req-scroll">
            <table class="table table-hover align-middle req-table">
                <thead class="table-light">
                    <tr><th>신청자</th><th>종류</th><th>시작일 ▲</th><th>종료일</th><th>일수</th><th>사유</th><th>상태</th><th>처리</th></tr>
                </thead>
                <tbody>
                    @foreach (var l in FilteredLeaves)
                    {
                        <tr>
                            <td data-label="신청자"><strong>@l.UserName</strong></td>
                            <td data-label="종류">@l.LeaveType@(string.IsNullOrEmpty(l.Period) ? "" : $" ({l.Period})")</td>
                            <td data-label="시작일">@l.StartDate.ToString("yyyy-MM-dd")</td>
                            <td data-label="종료일">@l.EndDate.ToString("yyyy-MM-dd")</td>
                            <td data-label="일수">@Fmt.Day(l.Days)</td>
                            <td data-label="사유"><small>@l.Reason</small></td>
                            <td data-label="상태">@StatusBadge(l.Status)</td>
                            <td data-label="처리">
                                @if (l.Status == "대기")
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        <button class="btn btn-sm btn-success" @onclick="() => ApproveLeave(l)">승인</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectLeave(l)">반려</button>
                                    </div>
                                }
                                else if (l.Status == "승인")
                                {
                                    <div class="d-flex flex-wrap gap-1 align-items-center">
                                        <small class="text-muted">@l.ApprovedByName</small>
                                        <button class="btn btn-sm btn-outline-warning text-nowrap" @onclick='() => OpenRevert("Leave", l.Id)'>↺ 취소</button>
                                    </div>
                                }
                                else
                                {
                                    <small class="text-muted">@l.ApprovedByName</small>
                                }
                            </td>
                        </tr>
                    }
                    @if (!FilteredLeaves.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">항목 없음</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ---------- 포상 ---------- *@
    @if (tab == "reward")
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="pendR" @bind="showPendingOnly" />
                <label class="form-check-label" for="pendR">대기 항목만 보기</label>
            </div>
            <button class="btn btn-sm btn-success" @onclick="OpenGrant">+ 관리자 포상 부여</button>
        </div>
        <div class="table-responsive req-scroll">
            <table class="table table-hover align-middle req-table">
                <thead class="table-light">
                    <tr><th>신청일 ▲</th><th>대상자</th><th>포상 일수</th><th>근무시간</th><th>사유</th><th>구분</th><th>상태</th><th>처리</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in FilteredRewards)
                    {
                        <tr>
                            <td data-label="신청일"><small>@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td data-label="대상자"><strong>@r.UserName</strong></td>
                            <td data-label="포상 일수">@Fmt.Day(r.Amount)</td>
                            <td data-label="근무시간">@Fmt.Day(r.WorkHours)</td>
                            <td data-label="사유"><small>@r.Reason</small></td>
                            <td data-label="구분"><small>@r.Source</small></td>
                            <td data-label="상태">@StatusBadge(r.Status)</td>
                            <td data-label="처리">
                                @if (r.Status == "대기")
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        <button class="btn btn-sm btn-success" @onclick="() => ApproveReward(r)">승인</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectReward(r)">반려</button>
                                    </div>
                                }
                                else if (r.Status == "승인")
                                {
                                    <div class="d-flex flex-column gap-1">
                                        <small class="text-muted">@r.ApprovedByName</small>
                                        <button class="btn btn-sm btn-outline-warning" @onclick='() => OpenRevert("Reward", r.Id)'>↺ 승인취소</button>
                                    </div>
                                }
                                else
                                {
                                    <small class="text-muted">@r.ApprovedByName</small>
                                }
                            </td>
                        </tr>
                    }
                    @if (!FilteredRewards.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">항목 없음</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ---------- 비품/간식 ---------- *@
    @if (tab == "supply")
    {
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="pendS" @bind="showPendingOnly" />
            <label class="form-check-label" for="pendS">대기 항목만 보기</label>
        </div>
        <div class="table-responsive req-scroll">
            <table class="table table-hover align-middle req-table">
                <thead class="table-light">
                    <tr><th>신청일 ▲</th><th>신청자</th><th>분류</th><th>품목</th><th>수량</th><th>메모</th><th>상태</th><th>처리</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in FilteredSupplies)
                    {
                        <tr>
                            <td data-label="신청일"><small>@s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td data-label="신청자"><strong>@s.UserName</strong></td>
                            <td data-label="분류">@s.Category</td>
                            <td data-label="품목">@s.ItemName</td>
                            <td data-label="수량">@s.Quantity</td>
                            <td data-label="메모"><small>@s.Note</small></td>
                            <td data-label="상태">@StatusBadge(s.Status)</td>
                            <td data-label="처리">
                                <div class="d-flex flex-wrap gap-1">
                                    @if (s.Status == "대기")
                                    {
                                        <button class="btn btn-sm btn-success" @onclick='() => SetSupplyStatus(s, "승인")'>승인</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick='() => SetSupplyStatus(s, "반려")'>반려</button>
                                    }
                                    else if (s.Status == "승인")
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick='() => SetSupplyStatus(s, "완료")'>완료</button>
                                        <button class="btn btn-sm btn-outline-warning" @onclick='() => OpenRevert("Supply", s.Id)'>↺ 취소</button>
                                    }
                                    @* 관리자는 어떤 상태든 영구 삭제 가능 *@
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => DeleteSupply(s)">🗑</button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!FilteredSupplies.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">항목 없음</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ---------- 승인취소 내역 탭 ---------- *@
    @if (tab == "reverts")
    {
        <div class="table-responsive req-scroll">
            <table class="table table-sm table-hover align-middle req-table">
                <thead class="table-light">
                    <tr><th>취소 시각</th><th>구분</th><th>대상자</th><th>분류</th><th>복원량</th><th>요약</th><th>사유</th><th>처리자</th></tr>
                </thead>
                <tbody>
                    @if (reverts == null || reverts.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center text-muted">승인취소 내역이 없습니다.</td></tr>
                    }
                    else
                    {
                        @foreach (var rv in reverts)
                        {
                            <tr>
                                <td data-label="대상자"><strong>@rv.UserName</strong></td>
                                <td data-label="구분"><span class="badge bg-secondary">@RevertTypeLabel(rv.RequestType)</span></td>
                                <td data-label="분류"><small>@(rv.Category ?? "-")</small></td>
                                <td data-label="복원량">@(rv.Amount.HasValue ? $"+{Fmt.Day(rv.Amount.Value)} 복원" : "-")</td>
                                <td data-label="요약"><small>@rv.Summary</small></td>
                                <td data-label="사유"><small>@rv.Reason</small></td>
                                <td data-label="처리자"><small>@rv.RevertedByName</small></td>
                                <td data-label="취소 시각"><small>@rv.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ---------- 승인취소 확인 모달 ---------- *@
@if (revertingTarget != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" @onclick="CancelRevert">
        <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down" @onclick:stopPropagation="true" @onclick="NoOp">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-warning">↺ 승인취소</h5>
                    <button type="button" class="btn-close" @onclick="CancelRevert"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2"><strong>@revertingTarget.Description</strong></p>
                    @if (revertingTarget.Amount.HasValue && revertingTarget.Amount > 0)
                    {
                        <div class="alert alert-info py-2 small mb-2">
                            ✅ 승인 시 차감했던 <strong>@Fmt.Day(revertingTarget.Amount.Value)일</strong>을 직원에게 복원합니다.
                        </div>
                    }
                    <div class="alert alert-warning py-2 small mb-3">
                        ⚠️ 이미 사용된 날짜라도 시스템상으론 복원됩니다. 직원에게 별도 안내가 필요할 수 있어요.
                    </div>
                    <div class="mb-0">
                        <label class="form-label">취소 사유 <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="2" placeholder="예: 실수로 승인했음, 직원 요청"
                                  @bind="revertReason"></textarea>
                    </div>
                    @if (!string.IsNullOrEmpty(revertError))
                    {
                        <div class="alert alert-danger mt-2 mb-0 py-2">@revertError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelRevert">닫기</button>
                    <button class="btn btn-warning" @onclick="ConfirmRevert" disabled="@reverting">@(reverting ? "처리 중..." : "승인 취소")</button>
                </div>
            </div>
        </div>
    </div>
}

@* ---------- 관리자 포상 부여 모달 ---------- *@
@if (granting)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" @onclick='() => granting = false'>
        <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down" @onclick:stopPropagation="true" @onclick="NoOp">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">관리자 포상 부여</h5>
                    <button type="button" class="btn-close" @onclick="() => granting = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">대상 직원</label>
                        <select class="form-select" @bind="grantUserId">
                            <option value="">선택</option>
                            @foreach (var u in allUsers)
                            {
                                <option value="@u.Id">@u.KoreanName (@u.Email)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">포상 일수</label>
                        <input type="number" step="0.01" class="form-control" @bind="grantAmount" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">사유</label>
                        <input class="form-control" @bind="grantReason" />
                    </div>
                    @if (!string.IsNullOrEmpty(grantMsg))
                    {
                        <div class="alert alert-warning py-2 mb-0">@grantMsg</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => granting = false">취소</button>
                    <button class="btn btn-success" @onclick="GrantReward">부여 (즉시 승인)</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string tab = "leave";
    private bool showPendingOnly = true;

    private List<LeaveRequest>? leaves;
    private List<RewardRecord>? rewards;
    private List<SupplyRequest>? supplies;
    private List<ApprovalRevertLog>? reverts;
    private List<ApplicationUser> allUsers = new();

    private string? adminId;
    private string? adminName;

    // 승인취소 모달 상태
    private RevertTarget? revertingTarget;
    private string revertReason = "";
    private string? revertError;
    private bool reverting;

    private record RevertTarget(string RequestType, int RequestId, string Description, decimal? Amount);

    // 포상 부여 모달
    private bool granting;
    private string grantUserId = "";
    private decimal grantAmount;
    private string grantReason = "";
    private string? grantMsg;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        adminId = principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        adminName = principal.FindFirst("KoreanName")?.Value ?? principal.Identity?.Name;
        await LoadAll();
    }

    private async Task LoadAll()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        leaves = await db.LeaveRequests.AsNoTracking().OrderBy(l => l.StartDate).ThenBy(l => l.CreatedAt).ToListAsync();
        rewards = await db.RewardRecords.AsNoTracking().OrderBy(r => r.CreatedAt).ToListAsync();
        supplies = await db.SupplyRequests.AsNoTracking().OrderBy(s => s.CreatedAt).ToListAsync();
        reverts = await db.ApprovalRevertLogs.AsNoTracking().OrderByDescending(x => x.CreatedAt).Take(200).ToListAsync();
        allUsers = await db.Users.AsNoTracking().OrderBy(u => u.KoreanName).ToListAsync();
    }

    private static string RevertTypeLabel(string type) => type switch
    {
        "Leave" => "휴가", "Reward" => "포상", "Supply" => "비품/간식", _ => type
    };

    private void OpenRevert(string type, int id)
    {
        revertError = null;
        revertReason = "";
        switch (type)
        {
            case "Leave":
                var l = leaves?.FirstOrDefault(x => x.Id == id);
                if (l == null || l.Status != "승인") return;
                revertingTarget = new RevertTarget(type, id,
                    $"{l.UserName} · {l.LeaveType} · {l.StartDate:yyyy-MM-dd}~{l.EndDate:MM-dd} ({Fmt.Day(l.Days)}일)",
                    l.Days);
                break;
            case "Reward":
                var r = rewards?.FirstOrDefault(x => x.Id == id);
                if (r == null || r.Status != "승인") return;
                revertingTarget = new RevertTarget(type, id,
                    $"{r.UserName} · 포상 {Fmt.Day(r.Amount)}일 · {r.Source}",
                    r.Amount);
                break;
            case "Supply":
                var s = supplies?.FirstOrDefault(x => x.Id == id);
                if (s == null || s.Status is not ("승인" or "완료")) return;
                revertingTarget = new RevertTarget(type, id,
                    $"{s.UserName} · {s.Category} · {s.ItemName} ×{s.Quantity}",
                    null);
                break;
        }
    }

    private void CancelRevert()
    {
        revertingTarget = null;
        revertReason = "";
        revertError = null;
    }

    private void NoOp() { /* 모달 내부 클릭 propagation 차단 */ }

    private async Task ConfirmRevert()
    {
        if (revertingTarget == null || reverting) return;
        if (string.IsNullOrWhiteSpace(revertReason)) { revertError = "취소 사유를 입력해주세요."; return; }

        reverting = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var log = new ApprovalRevertLog
            {
                RequestType = revertingTarget.RequestType,
                RequestId = revertingTarget.RequestId,
                Reason = revertReason.Trim(),
                RevertedById = adminId,
                RevertedByName = adminName,
                CreatedAt = DateTime.UtcNow
            };

            switch (revertingTarget.RequestType)
            {
                case "Leave":
                {
                    var target = await db.LeaveRequests.FindAsync(revertingTarget.RequestId);
                    if (target == null || target.Status != "승인") { revertError = "이미 처리된 항목입니다."; return; }
                    var u = await UserManager.FindByIdAsync(target.UserId);
                    if (u != null)
                    {
                        switch (target.LeaveType)
                        {
                            case "연차":
                            case "반차":
                            case "반반차": u.UsedAnnualLeave = Math.Max(0, u.UsedAnnualLeave - target.Days); break;
                            case "병가": u.SickLeaveUsed = Math.Max(0, u.SickLeaveUsed - target.Days); break;
                            case "포상휴가": u.UsedRewardLeave = Math.Max(0, u.UsedRewardLeave - target.Days); break;
                        }
                        u.UpdatedAt = DateTime.UtcNow;
                        await UserManager.UpdateAsync(u);
                    }
                    log.UserId = target.UserId;
                    log.UserName = target.UserName;
                    log.Category = target.LeaveType;
                    log.Amount = target.Days;
                    log.OriginalStatus = "승인";
                    log.Summary = $"{target.LeaveType} {target.StartDate:yyyy-MM-dd}~{target.EndDate:MM-dd} ({Fmt.Day(target.Days)}일) 승인 취소";
                    target.Status = "승인취소";
                    target.ApprovedById = adminId;
                    target.ApprovedByName = adminName;
                    target.ApprovedAt = DateTime.UtcNow;
                    break;
                }
                case "Reward":
                {
                    var target = await db.RewardRecords.FindAsync(revertingTarget.RequestId);
                    if (target == null || target.Status != "승인") { revertError = "이미 처리된 항목입니다."; return; }
                    var u = await UserManager.FindByIdAsync(target.UserId);
                    if (u != null)
                    {
                        u.RewardLeave = Math.Max(0, u.RewardLeave - target.Amount);
                        u.UpdatedAt = DateTime.UtcNow;
                        await UserManager.UpdateAsync(u);
                    }
                    log.UserId = target.UserId;
                    log.UserName = target.UserName;
                    log.Category = $"포상 ({target.Source})";
                    log.Amount = target.Amount;
                    log.OriginalStatus = "승인";
                    log.Summary = $"포상 {Fmt.Day(target.Amount)}일 ({target.Source}) 승인 취소";
                    target.Status = "승인취소";
                    target.ApprovedById = adminId;
                    target.ApprovedByName = adminName;
                    target.ApprovedAt = DateTime.UtcNow;
                    break;
                }
                case "Supply":
                {
                    var target = await db.SupplyRequests.FindAsync(revertingTarget.RequestId);
                    if (target == null || target.Status is not ("승인" or "완료")) { revertError = "이미 처리된 항목입니다."; return; }
                    log.UserId = target.UserId;
                    log.UserName = target.UserName;
                    log.Category = $"{target.Category} - {target.ItemName}";
                    log.Amount = null;
                    log.OriginalStatus = target.Status;
                    log.Summary = $"{target.Category} {target.ItemName} ×{target.Quantity} ({target.Status}) 승인 취소";
                    target.Status = "승인취소";
                    break;
                }
            }

            db.ApprovalRevertLogs.Add(log);
            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            revertError = "오류: " + ex.Message;
            return;
        }
        finally
        {
            reverting = false;
        }

        revertingTarget = null;
        revertReason = "";
        await LoadAll();
    }

    private IEnumerable<LeaveRequest> FilteredLeaves =>
        (leaves ?? new()).Where(l => !showPendingOnly || l.Status == "대기");
    private IEnumerable<RewardRecord> FilteredRewards =>
        (rewards ?? new()).Where(r => !showPendingOnly || r.Status == "대기");
    private IEnumerable<SupplyRequest> FilteredSupplies =>
        (supplies ?? new()).Where(s => !showPendingOnly || s.Status == "대기");

    private async Task ApproveLeave(LeaveRequest l)
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var target = await db.LeaveRequests.FindAsync(l.Id);
            if (target == null || target.Status != "대기") return;

            var u = await UserManager.FindByIdAsync(target.UserId);
            if (u != null)
            {
                switch (target.LeaveType)
                {
                    case "연차":
                    case "반차":
                    case "반반차": u.UsedAnnualLeave += target.Days; break;
                    case "병가": u.SickLeaveUsed += target.Days; break;
                    case "포상휴가": u.UsedRewardLeave += target.Days; break;
                }
                u.UpdatedAt = DateTime.UtcNow;
                await UserManager.UpdateAsync(u);
            }

            target.Status = "승인";
            target.ApprovedById = adminId;
            target.ApprovedByName = adminName;
            target.ApprovedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();

            // 신청자에게 푸시
            _ = Push.SendToUserAsync(target.UserId,
                "휴가 신청 승인됨",
                $"{target.LeaveType} {target.StartDate:MM-dd}~{target.EndDate:MM-dd} ({Fmt.Day(target.Days)}일) 승인 완료",
                "/requests",
                "휴가");
        }
        await LoadAll();
    }

