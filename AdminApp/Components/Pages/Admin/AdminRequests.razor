@page "/admin/requests"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>신청 관리</PageTitle>

<div class="container-fluid py-3">
    <h2 class="mb-3">신청 관리</h2>

    <ul class="nav nav-tabs mb-3">
        <li class="nav-item"><button class="nav-link @(tab == "leave" ? "active" : "")" @onclick='() => tab = "leave"'>휴가 (@leaves?.Count(l => l.Status == "대기") 대기)</button></li>
        <li class="nav-item"><button class="nav-link @(tab == "reward" ? "active" : "")" @onclick='() => tab = "reward"'>포상 (@rewards?.Count(r => r.Status == "대기") 대기)</button></li>
        <li class="nav-item"><button class="nav-link @(tab == "supply" ? "active" : "")" @onclick='() => tab = "supply"'>비품/간식 (@supplies?.Count(s => s.Status == "대기") 대기)</button></li>
    </ul>

    @* ---------- 휴가 ---------- *@
    @if (tab == "leave")
    {
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="pendL" @bind="showPendingOnly" />
            <label class="form-check-label" for="pendL">대기 항목만 보기</label>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>신청자</th><th>종류</th><th>시작일 ▲</th><th>종료일</th><th>일수</th><th>사유</th><th>상태</th><th>처리</th></tr>
                </thead>
                <tbody>
                    @foreach (var l in FilteredLeaves)
                    {
                        <tr>
                            <td>@l.UserName</td>
                            <td>@l.LeaveType</td>
                            <td>@l.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>@l.EndDate.ToString("yyyy-MM-dd")</td>
                            <td>@Fmt.Day(l.Days)</td>
                            <td><small>@l.Reason</small></td>
                            <td>@StatusBadge(l.Status)</td>
                            <td>
                                @if (l.Status == "대기")
                                {
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => ApproveLeave(l)">승인</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectLeave(l)">반려</button>
                                }
                                else
                                {
                                    <small class="text-muted">@l.ApprovedByName @l.ApprovedAt?.ToLocalTime().ToString("MM-dd HH:mm")</small>
                                }
                            </td>
                        </tr>
                    }
                    @if (!FilteredLeaves.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">항목 없음</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ---------- 포상 ---------- *@
    @if (tab == "reward")
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="pendR" @bind="showPendingOnly" />
                <label class="form-check-label" for="pendR">대기 항목만 보기</label>
            </div>
            <button class="btn btn-sm btn-success" @onclick="OpenGrant">+ 관리자 포상 부여</button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>신청일 ▲</th><th>대상자</th><th>포상 일수</th><th>근무시간</th><th>사유</th><th>구분</th><th>상태</th><th>처리</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in FilteredRewards)
                    {
                        <tr>
                            <td><small>@r.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td>@r.UserName</td>
                            <td>@Fmt.Day(r.Amount)</td>
                            <td>@Fmt.Day(r.WorkHours)</td>
                            <td><small>@r.Reason</small></td>
                            <td><small>@r.Source</small></td>
                            <td>@StatusBadge(r.Status)</td>
                            <td>
                                @if (r.Status == "대기")
                                {
                                    <button class="btn btn-sm btn-success me-1" @onclick="() => ApproveReward(r)">승인</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectReward(r)">반려</button>
                                }
                                else
                                {
                                    <small class="text-muted">@r.ApprovedByName</small>
                                }
                            </td>
                        </tr>
                    }
                    @if (!FilteredRewards.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">항목 없음</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ---------- 비품/간식 ---------- *@
    @if (tab == "supply")
    {
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" id="pendS" @bind="showPendingOnly" />
            <label class="form-check-label" for="pendS">대기 항목만 보기</label>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr><th>신청일 ▲</th><th>신청자</th><th>분류</th><th>품목</th><th>수량</th><th>메모</th><th>상태</th><th>처리</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in FilteredSupplies)
                    {
                        <tr>
                            <td><small>@s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td>@s.UserName</td>
                            <td>@s.Category</td>
                            <td>@s.ItemName</td>
                            <td>@s.Quantity</td>
                            <td><small>@s.Note</small></td>
                            <td>@StatusBadge(s.Status)</td>
                            <td>
                                @if (s.Status == "대기")
                                {
                                    <button class="btn btn-sm btn-success me-1" @onclick='() => SetSupplyStatus(s, "승인")'>승인</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick='() => SetSupplyStatus(s, "반려")'>반려</button>
                                }
                                else if (s.Status == "승인")
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick='() => SetSupplyStatus(s, "완료")'>완료 처리</button>
                                }
                                else
                                {
                                    <small class="text-muted">-</small>
                                }
                            </td>
                        </tr>
                    }
                    @if (!FilteredSupplies.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">항목 없음</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ---------- 관리자 포상 부여 모달 ---------- *@
@if (granting)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">관리자 포상 부여</h5>
                    <button type="button" class="btn-close" @onclick="() => granting = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">대상 직원</label>
                        <select class="form-select" @bind="grantUserId">
                            <option value="">선택</option>
                            @foreach (var u in allUsers)
                            {
                                <option value="@u.Id">@u.KoreanName (@u.Email)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">포상 일수</label>
                        <input type="number" step="0.01" class="form-control" @bind="grantAmount" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">사유</label>
                        <input class="form-control" @bind="grantReason" />
                    </div>
                    @if (!string.IsNullOrEmpty(grantMsg))
                    {
                        <div class="alert alert-warning py-2 mb-0">@grantMsg</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => granting = false">취소</button>
                    <button class="btn btn-success" @onclick="GrantReward">부여 (즉시 승인)</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string tab = "leave";
    private bool showPendingOnly = true;

    private List<LeaveRequest>? leaves;
    private List<RewardRecord>? rewards;
    private List<SupplyRequest>? supplies;
    private List<ApplicationUser> allUsers = new();

    private string? adminId;
    private string? adminName;

    // 포상 부여 모달
    private bool granting;
    private string grantUserId = "";
    private decimal grantAmount;
    private string grantReason = "";
    private string? grantMsg;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        adminId = principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        adminName = principal.FindFirst("KoreanName")?.Value ?? principal.Identity?.Name;
        await LoadAll();
    }

    private async Task LoadAll()
    {
        leaves = await Db.LeaveRequests.AsNoTracking().OrderBy(l => l.StartDate).ThenBy(l => l.CreatedAt).ToListAsync();
        rewards = await Db.RewardRecords.AsNoTracking().OrderBy(r => r.CreatedAt).ToListAsync();
        supplies = await Db.SupplyRequests.AsNoTracking().OrderBy(s => s.CreatedAt).ToListAsync();
        allUsers = await Db.Users.AsNoTracking().OrderBy(u => u.KoreanName).ToListAsync();
    }

    private IEnumerable<LeaveRequest> FilteredLeaves =>
        (leaves ?? new()).Where(l => !showPendingOnly || l.Status == "대기");
    private IEnumerable<RewardRecord> FilteredRewards =>
        (rewards ?? new()).Where(r => !showPendingOnly || r.Status == "대기");
    private IEnumerable<SupplyRequest> FilteredSupplies =>
        (supplies ?? new()).Where(s => !showPendingOnly || s.Status == "대기");

    private async Task ApproveLeave(LeaveRequest l)
    {
        var target = await Db.LeaveRequests.FindAsync(l.Id);
        if (target == null || target.Status != "대기") return;

        var u = await UserManager.FindByIdAsync(target.UserId);
        if (u != null)
        {
            switch (target.LeaveType)
            {
                case "연차":
                case "반차": u.UsedAnnualLeave += target.Days; break;
                case "병가": u.SickLeaveUsed += target.Days; break;
                case "포상휴가": u.UsedRewardLeave += target.Days; break;
            }
            u.UpdatedAt = DateTime.UtcNow;
            await UserManager.UpdateAsync(u);
        }

        target.Status = "승인";
        target.ApprovedById = adminId;
        target.ApprovedByName = adminName;
        target.ApprovedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await LoadAll();
    }

    private async Task RejectLeave(LeaveRequest l)
    {
        var target = await Db.LeaveRequests.FindAsync(l.Id);
        if (target == null) return;
        target.Status = "반려";
        target.ApprovedById = adminId;
        target.ApprovedByName = adminName;
        target.ApprovedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await LoadAll();
    }

    private async Task ApproveReward(RewardRecord r)
    {
        var target = await Db.RewardRecords.FindAsync(r.Id);
        if (target == null || target.Status != "대기") return;

        var u = await UserManager.FindByIdAsync(target.UserId);
        if (u != null)
        {
            u.RewardLeave += target.Amount;
            u.UpdatedAt = DateTime.UtcNow;
            await UserManager.UpdateAsync(u);
        }

        target.Status = "승인";
        target.ApprovedById = adminId;
        target.ApprovedByName = adminName;
        target.ApprovedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await LoadAll();
    }

    private async Task RejectReward(RewardRecord r)
    {
        var target = await Db.RewardRecords.FindAsync(r.Id);
        if (target == null) return;
        target.Status = "반려";
        target.ApprovedById = adminId;
        target.ApprovedByName = adminName;
        target.ApprovedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        await LoadAll();
    }

    private async Task SetSupplyStatus(SupplyRequest s, string status)
    {
        var target = await Db.SupplyRequests.FindAsync(s.Id);
        if (target == null) return;
        target.Status = status;
        await Db.SaveChangesAsync();
        await LoadAll();
    }

    private void OpenGrant()
    {
        granting = true;
        grantUserId = "";
        grantAmount = 0;
        grantReason = "";
        grantMsg = null;
    }

    private async Task GrantReward()
    {
        grantMsg = null;
        if (string.IsNullOrEmpty(grantUserId)) { grantMsg = "대상 직원을 선택해주세요."; return; }
        if (grantAmount <= 0) { grantMsg = "포상 일수를 입력해주세요."; return; }

        var u = await UserManager.FindByIdAsync(grantUserId);
        if (u == null) { grantMsg = "직원을 찾을 수 없습니다."; return; }

        var rec = new RewardRecord
        {
            UserId = u.Id,
            UserName = u.KoreanName ?? u.Email,
            Amount = grantAmount,
            Reason = string.IsNullOrWhiteSpace(grantReason) ? "관리자 부여" : grantReason,
            Source = "관리자부여",
            Status = "승인",
            ApprovedById = adminId,
            ApprovedByName = adminName,
            ApprovedAt = DateTime.UtcNow,
            CreatedAt = DateTime.UtcNow
        };
        Db.RewardRecords.Add(rec);

        u.RewardLeave += grantAmount;
        u.UpdatedAt = DateTime.UtcNow;
        await UserManager.UpdateAsync(u);
        await Db.SaveChangesAsync();

        granting = false;
        await LoadAll();
    }

    private static MarkupString StatusBadge(string status)
    {
        var cls = status switch
        {
            "승인" => "bg-success",
            "완료" => "bg-primary",
            "반려" => "bg-danger",
            _ => "bg-secondary"
        };
        return new MarkupString($"<span class=\"badge {cls}\">{status}</span>");
    }
}
