        ["r_food"] = new(null, null, new Result("음식물 쓰레기", CFood, "음식물 쓰레기로 배출",
            new[] { "물기를 최대한 제거", "이쑤시개 · 비닐 · 뼈 등 이물질 빼기", "전용 봉투 또는 음식물 수거함에" })),
