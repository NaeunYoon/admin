        // ---------- 스티로폼 ----------
        ["styro"] = new("깨끗한 흰색 스티로폼인가요?", new[]
        {
            new Option("네, 깨끗한 흰색이에요", "r_styro"),
            new Option("색깔이 있거나 이물질·테이프가 붙어 있어요", "r_trash_dirty"),
