            new Option("🍚 음식물 · 음식 찌꺼기", "food"),
            new Option("🚬 담배꽁초 · 재", "r_cig"),
            new Option("📦 스티로폼", "styro"),
            new Option("❓ 그 외 / 잘 모르겠어요", "etc"),
        }, null),

        // ---------- 종이 ----------
        ["paper"] = new("기름·음식물 등 이물질이 묻어 있나요?", new[]
        {
            new Option("네, 묻어 있어요", "r_trash_dirty"),
            new Option("아니요, 깨끗해요", "paper2"),
        }, null),
        ["paper2"] = new("어떤 종이인가요?", new[]
        {
            new Option("우유팩 · 멸균팩 (종이팩)", "r_paperpack"),
            new Option("신문 · 책 · 복사용지 · 상자", "r_paper"),
            new Option("영수증 · 코팅지 · 은박지 · 벽지 · 사진", "r_trash_coated"),
        }, null),

        // ---------- 플라스틱/비닐 ----------
        ["plastic"] = new("어떤 형태인가요?", new[]
        {
            new Option("비닐봉지 · 포장 비닐 · 뽁뽁이", "vinyl"),
