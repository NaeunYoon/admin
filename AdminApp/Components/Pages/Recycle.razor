        ["r_vinyl"] = new(null, null, new Result("비닐류", CVinyl, "비닐류로 배출",
            new[] { "내용물 비우고 깨끗하게", "여러 장은 모아서 한 봉투에", "이물질이 묻으면 일반쓰레기로" })),
        ["r_pet"] = new(null, null, new Result("투명 페트병", CPet, "투명 페트병(별도)으로 배출",
            new[] { "라벨(비닐) 제거 → 비닐류로", "내용물 비우고 헹군 뒤 찌그러뜨리기", "뚜껑은 닫아서 함께 배출 가능", "색깔 있는 페트병은 '플라스틱류'로" })),
        ["r_plastic"] = new(null, null, new Result("플라스틱류", CPlastic, "플라스틱류로 배출",
            new[] { "내용물 비우고 헹굼", "금속 펌프 · 스프링 등 다른 재질 분리", "오염이 심하면 일반쓰레기로" })),
        ["r_glass"] = new(null, null, new Result("유리류", CGlass, "유리류로 배출",
            new[] { "내용물 비우고 헹굼", "병뚜껑은 따로 (금속/플라스틱류)", "소주·맥주병은 마트에서 보증금 반환 가능" })),
        ["r_can"] = new(null, null, new Result("캔류", CCan, "캔류로 배출",
            new[] { "내용물 비우고 헹굼", "겉의 비닐 라벨 제거", "납작하게 눌러서 부피 줄이기" })),
        ["r_can_gas"] = new(null, null, new Result("캔류 (가스 제거 후)", CGas, "가스 완전히 비운 뒤 캔류로",
