@page "/recycle"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

<PageTitle>분리배출 도우미</PageTitle>

<div class="container py-3" style="max-width: 680px;">
    <div class="text-center mb-3">
        <h2 class="fs-3 mb-1">♻️ 분리배출 도우미</h2>
        <small class="text-muted">질문에 답하면 어디에 버려야 하는지 알려드려요.</small>
    </div>

    @* 진행 경로 *@
    @if (history.Count > 0)
    {
        <div class="mb-3 small text-muted">
            @foreach (var (label, idx) in breadcrumbs.Select((l, i) => (l, i)))
            {
                <span>@label</span>
                @if (idx < breadcrumbs.Count - 1)
                {
                    <span class="mx-1">›</span>
                }
            }
        </div>
    }

    @{ var node = Nodes[currentId]; }

    @if (node.Result != null)
    {
        @* ---------- 결과 카드 ---------- *@
        var r = node.Result;
        <div class="card shadow-sm border-0 mb-3">
            <div class="result-banner" style="background-color:@r.Color;">
                <div class="result-cat">@r.Category</div>
                <div class="result-title">@r.Title</div>
            </div>
            <div class="card-body">
                <h6 class="text-muted mb-2">이렇게 버려주세요</h6>
                <ul class="mb-0">
                    @foreach (var tip in r.Tips)
                    {
                        <li class="mb-1">@tip</li>
                    }
                </ul>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" @onclick="Back">← 이전</button>
            <button class="btn btn-primary flex-grow-1" @onclick="Restart">처음부터 다시</button>
        </div>
    }
    else
    {
        @* ---------- 질문 카드 ---------- *@
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <h4 class="fs-5 mb-3">@node.Question</h4>
                <div class="d-grid gap-2">
                    @foreach (var opt in node.Options!)
                    {
                        var o = opt;
                        <button class="btn btn-outline-primary text-start py-2" @onclick="() => Choose(o)">
                            @o.Label
                        </button>
                    }
                </div>
            </div>
        </div>
        @if (history.Count > 0)
        {
            <button class="btn btn-outline-secondary" @onclick="Back">← 이전 질문</button>
        }
    }

    <div class="text-center mt-4">
        <small class="text-muted">
            ※ 지역(시·군·구)마다 기준이 조금씩 달라요. 헷갈리면 관리자에게 문의하세요.
        </small>
    </div>
</div>

<style>
    .result-banner {
        color: #fff;
        padding: 1.5rem;
        text-align: center;
        text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    }
    .result-banner .result-cat {
        font-size: 0.85rem;
        opacity: 0.9;
        letter-spacing: 0.05em;
    }
    .result-banner .result-title {
        font-size: 1.4rem;
        font-weight: 800;
        margin-top: 0.25rem;
    }
</style>

@code {
    private string currentId = "start";
    private readonly List<string> history = new();
    private readonly List<string> breadcrumbs = new();

    private void Choose(Option o)
    {
        history.Add(currentId);
        breadcrumbs.Add(o.Label);
        currentId = o.Next;
    }

    private void Back()
    {
        if (history.Count == 0) return;
        currentId = history[^1];
        history.RemoveAt(history.Count - 1);
        if (breadcrumbs.Count > 0) breadcrumbs.RemoveAt(breadcrumbs.Count - 1);
    }

    private void Restart()
    {
        currentId = "start";
        history.Clear();
        breadcrumbs.Clear();
    }

    private record Option(string Label, string Next);
    private record Result(string Category, string Color, string Title, string[] Tips);
    private record Node(string? Question, Option[]? Options, Result? Result = null);

    // ===== 색상 팔레트 =====
    private const string CPaper = "#3b82f6";   // 종이 파랑
