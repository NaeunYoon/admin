    private const string CPet = "#06b6d4";     // 페트 청록
    private const string CPlastic = "#10b981"; // 플라스틱 초록
    private const string CGlass = "#8b5cf6";   // 유리 보라
    private const string CCan = "#64748b";     // 캔 회색
    private const string CGas = "#ef4444";     // 가스 빨강
    private const string CFood = "#92400e";    // 음식물 갈색
    private const string CTrash = "#374151";   // 일반쓰레기 진회색
    private const string CSpecial = "#db2777"; // 전용수거 자홍

    private static readonly Dictionary<string, Node> Nodes = new()
    {
        ["start"] = new("버리려는 물건이 무엇인가요?", new[]
        {
