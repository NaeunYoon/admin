@page "/insights/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@using Microsoft.EntityFrameworkCore
@using AdminApp.Data

<PageTitle>@(article?.Title ?? "인사이트")</PageTitle>

<div class="container py-3" style="max-width: 880px;">
    <a class="btn btn-link p-0 mb-2 text-decoration-none" href="insights">← 아카이브로</a>

    @if (article == null)
    {
        <p>로딩 중...</p>
    }
    else
    {
        <h2 class="mb-2">@article.Title</h2>
        <div class="text-muted small mb-3">
            <span>@(article.Source ?? "출처 미상")</span>
            @if (article.PublishedDate.HasValue)
            {
                <span> · @article.PublishedDate.Value.ToString("yyyy.MM.dd")</span>
            }
            @if (article.FeaturedOrder > 0)
            {
                <span class="badge bg-warning text-dark ms-2">오늘의 픽 @CircledNumber(article.FeaturedOrder)</span>
            }
        </div>

        @if (article.KeywordList.Any())
        {
            <div class="mb-3">
                @foreach (var k in article.KeywordList)
                {
                    <span class="badge bg-light text-dark border me-1">@k</span>
                }
            </div>
        }

        <div class="card shadow-sm border-0 mb-3">
            <div class="card-body">
                <h6 class="text-muted">한 줄 요약</h6>
                <p class="mb-0">@(article.OneLineSummary ?? "(요약 없음)")</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(article.FullContent))
        {
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body">
                    <h6 class="text-muted">상세 내용</h6>
                    <div style="white-space: pre-wrap;">@article.FullContent</div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-light border">
                <small class="text-muted">
                    Brave Search는 본문이 아닌 검색 스니펫만 제공해요. 전체 내용은 원문에서 확인하세요.
                    (향후 LLM 연동 시 자동 요약/번역으로 업그레이드 예정)
                </small>
            </div>
        }

        <div class="d-flex gap-2 mt-3">
            <a class="btn btn-primary" href="@article.Url" target="_blank" rel="noopener">🔗 원문 보기 →</a>
            @if (isAdmin)
            {
                <button class="btn btn-outline-secondary" @onclick="OpenEdit">편집</button>
                <button class="btn btn-outline-danger" @onclick="Delete">삭제</button>
            }
        </div>

        @* 관리자: 편집 모달 *@
        @if (editing != null)
        {
            <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" @onclick="@(() => editing = null)">
                <div class="modal-dialog modal-lg modal-dialog-centered" @onclick:stopPropagation="true" @onclick="NoOp">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">기사 편집</h5>
                            <button type="button" class="btn-close" @onclick="() => editing = null"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label class="form-label">제목</label>
                                <input class="form-control" @bind="editing.Title" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">한 줄 요약</label>
                                <textarea class="form-control" rows="2" @bind="editing.OneLineSummary"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">핵심 키워드 (쉼표로 구분)</label>
                                <input class="form-control" @bind="editing.Keywords" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">상세 내용 (선택)</label>
                                <textarea class="form-control" rows="6" @bind="editing.FullContent"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="() => editing = null">취소</button>
                            <button class="btn btn-primary" @onclick="SaveEdit">저장</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private InsightArticle? article;
    private InsightArticle? editing;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");
        await Load();
    }

    private async Task Load()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        article = await db.InsightArticles.AsNoTracking().FirstOrDefaultAsync(a => a.Id == Id);
    }

    private void OpenEdit()
    {
        if (!isAdmin || article == null) return;
        editing = new InsightArticle
        {
            Id = article.Id,
            Title = article.Title,
            OneLineSummary = article.OneLineSummary,
            Keywords = article.Keywords,
            FullContent = article.FullContent
        };
    }

    private async Task SaveEdit()
    {
        if (editing == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var target = await db.InsightArticles.FindAsync(editing.Id);
        if (target == null) { editing = null; return; }
        target.Title = editing.Title;
        target.OneLineSummary = editing.OneLineSummary;
        target.Keywords = editing.Keywords;
        target.FullContent = editing.FullContent;
        await db.SaveChangesAsync();
        editing = null;
        await Load();
    }

    private void NoOp() { }

    private async Task Delete()
    {
        if (!isAdmin || article == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.InsightArticles.Where(a => a.Id == article.Id).ExecuteDeleteAsync();
        Nav.NavigateTo("insights");
    }

    private static string CircledNumber(int n) => n switch
    {
        1 => "①", 2 => "②", 3 => "③", 4 => "④", 5 => "⑤", _ => n.ToString()
    };
}
