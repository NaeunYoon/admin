@page "/notices/{Id:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<PageTitle>공지사항</PageTitle>

<div class="container-fluid py-3">
    <div class="mb-3">
        <a class="btn btn-outline-secondary btn-sm" href="/">← 목록으로</a>
    </div>

    @if (loading)
    {
        <p>로딩 중...</p>
    }
    else if (notice == null)
    {
        <div class="text-center text-muted py-5">
            <div class="fs-1">🔍</div>
            <p>공지사항을 찾을 수 없습니다.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <h2 class="fs-3 mb-1">
                        @if (notice.IsPinned)
                        {
                            <span class="badge bg-danger me-1">고정</span>
                        }
                        @AdminApp.Helpers.RecycleMarker.Strip(notice.Title)
                    </h2>
                    <div class="btn-group btn-group-sm">
                        @if (canEdit)
                        {
                            <button class="btn btn-outline-secondary" @onclick="OpenEdit">수정</button>
                        }
                        @if (isAdmin)
                        {
                            <button class="btn btn-outline-danger" @onclick="DeleteNotice">삭제</button>
                        }
                    </div>
                </div>
                <small class="text-muted">@notice.AuthorName · @notice.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>

                <hr />
                @if (HasRecycleMarker)
                {
                    <a class="btn btn-success btn-lg w-100 mb-3" href="recycle">
                        ♻️ 분리배출 도우미 — 헷갈리면 여기서 확인하세요!
                    </a>
                }
                <p class="card-text" style="white-space: pre-wrap;">@CleanContent</p>

                @if (attachments.Count > 0)
                {
                    <hr />
                    <h6 class="text-muted">📎 첨부파일</h6>
                    <ul class="list-group list-group-flush">
                        @foreach (var a in attachments)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <a href="@($"/notices/attachments/{a.Id}")" target="_blank">@a.FileName</a>
                                <small class="text-muted">@FormatSize(a.Size)</small>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
</div>

@* ---------- 공지 수정 모달 ---------- *@
@if (editing != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" @onclick="Cancel">
        <div class="modal-dialog modal-lg modal-dialog-centered" @onclick:stopPropagation="true" @onclick="NoOp">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">공지 수정</h5>
                    <button type="button" class="btn-close" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">제목</label>
                        <input class="form-control" @bind="editing.Title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">내용</label>
                        <textarea class="form-control" rows="6" @bind="editing.Content"></textarea>
                    </div>

                    @if (attachments.Count > 0)
                    {
                        <div class="mb-3">
                            <label class="form-label">기존 첨부파일</label>
                            <ul class="list-group list-group-flush">
                                @foreach (var a in attachments)
                                {
                                    <li class="list-group-item px-0 py-1 d-flex justify-content-between align-items-center">
                                        <small>📎 @a.FileName</small>
                                        <button type="button" class="btn btn-sm btn-outline-danger py-0"
                                                @onclick="() => RemoveAttachment(a.Id)">삭제</button>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">첨부파일 추가 <small class="text-muted">(파일당 최대 10MB, 최대 5개)</small></label>
                        <InputFile class="form-control" OnChange="OnFilesSelected" multiple />
                        @if (pendingFiles.Count > 0)
                        {
                            <ul class="list-group list-group-flush mt-2">
                                @foreach (var f in pendingFiles)
                                {
                                    <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                                        <small>📎 @f.Name</small>
                                        <small class="text-muted">@FormatSize(f.Bytes.Length)</small>
                                    </li>
                                }
                            </ul>
                        }
                        @if (!string.IsNullOrEmpty(uploadError))
                        {
                            <div class="text-danger small mt-1">@uploadError</div>
                        }
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="pin" @bind="editing.IsPinned" />
                        <label class="form-check-label" for="pin">상단 고정</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cancel">취소</button>
                    <button class="btn btn-primary" @onclick="Save" disabled="@saving">@(saving ? "저장 중..." : "저장")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Notice? notice;
    private List<NoticeAttachment> attachments = new();
    private bool loading = true;

    // 제목 또는 본문에 마커가 있으면 도우미 버튼 표시 + 화면에서는 마커 글자 제거
    private bool HasRecycleMarker =>
        AdminApp.Helpers.RecycleMarker.Has(notice?.Title) ||
        AdminApp.Helpers.RecycleMarker.Has(notice?.Content);
    private string CleanContent => AdminApp.Helpers.RecycleMarker.Strip(notice?.Content);

    private Notice? editing;
    private bool isAdmin;
    private bool canEdit;

    // 첨부파일 업로드
    private record PendingFile(string Name, string ContentType, byte[] Bytes);
    private readonly List<PendingFile> pendingFiles = new();
    private readonly List<int> removedAttachmentIds = new();
    private string? uploadError;
    private bool saving;
    private const long MaxFileSize = 10 * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        isAdmin = principal.IsInRole("Admin");
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        notice = await db.Notices.AsNoTracking().FirstOrDefaultAsync(n => n.Id == Id);
        if (notice != null)
        {
            attachments = await db.NoticeAttachments.AsNoTracking()
                .Where(a => a.NoticeId == Id)
                .OrderBy(a => a.Id)
                .ToListAsync();
            // 수정: 직원·관리자 모두 가능 / 삭제: 관리자 전용(아래 isAdmin)
            canEdit = true;
        }
        loading = false;
    }

    private void OpenEdit()
    {
        if (notice == null) return;
        editing = new Notice
        {
            Id = notice.Id,
            Title = notice.Title,
            Content = notice.Content,
            IsPinned = notice.IsPinned
        };
        pendingFiles.Clear();
        removedAttachmentIds.Clear();
        uploadError = null;
    }

    private void Cancel()
    {
        editing = null;
        pendingFiles.Clear();
        removedAttachmentIds.Clear();
        uploadError = null;
    }

    private void NoOp() { }

    private void RemoveAttachment(int attId)
    {
        removedAttachmentIds.Add(attId);
        attachments.RemoveAll(a => a.Id == attId);
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;
        pendingFiles.Clear();
        foreach (var file in e.GetMultipleFiles(maximumFileCount: 5))
        {
            if (file.Size > MaxFileSize)
            {
                uploadError = $"'{file.Name}' 파일이 10MB를 초과합니다.";
                continue;
            }
            using var ms = new MemoryStream();
            await file.OpenReadStream(MaxFileSize).CopyToAsync(ms);
            pendingFiles.Add(new PendingFile(file.Name, file.ContentType, ms.ToArray()));
        }
    }

    private async Task Save()
    {
        if (editing == null || string.IsNullOrWhiteSpace(editing.Title)) return;
        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var target = await db.Notices.FindAsync(editing.Id);
            if (target != null)
            {
                target.Title = editing.Title;
                target.Content = editing.Content;
                target.IsPinned = editing.IsPinned;
                target.UpdatedAt = DateTime.UtcNow;
            }

            if (removedAttachmentIds.Count > 0)
            {
                var toRemove = await db.NoticeAttachments
                    .Where(a => removedAttachmentIds.Contains(a.Id))
                    .ToListAsync();
                db.NoticeAttachments.RemoveRange(toRemove);
            }

            foreach (var f in pendingFiles)
            {
                db.NoticeAttachments.Add(new NoticeAttachment
                {
                    NoticeId = editing.Id,
                    FileName = f.Name,
                    ContentType = f.ContentType,
                    Size = f.Bytes.Length,
                    Content = f.Bytes,
                    CreatedAt = DateTime.UtcNow
                });
            }

            await db.SaveChangesAsync();
        }
        finally
        {
            saving = false;
        }
        editing = null;
        pendingFiles.Clear();
        removedAttachmentIds.Clear();
        await Load();
    }

    private async Task DeleteNotice()
    {
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            var target = await db.Notices.FindAsync(Id);
            if (target != null)
            {
                db.Notices.Remove(target);
                await db.SaveChangesAsync();
            }
        }
        Nav.NavigateTo("/");
    }

    private static string FormatSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B"
        : bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB"
        : $"{bytes / (1024.0 * 1024):0.#} MB";
}
