@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>공지사항</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h2 class="mb-0">📢 공지사항</h2>
        <AuthorizeView Roles="Admin">
            <Authorized>
                <button class="btn btn-primary" @onclick="OpenNew">+ 공지 작성</button>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (notices == null)
    {
        <p>로딩 중...</p>
    }
    else if (notices.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <div class="fs-1">📭</div>
            <p>등록된 공지사항이 없습니다.</p>
        </div>
    }
    else
    {
        @foreach (var n in notices)
        {
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="card-title mb-1">
                            @if (n.IsPinned)
                            {
                                <span class="badge bg-danger me-1">고정</span>
                            }
                            @n.Title
                        </h5>
                        <AuthorizeView Roles="Admin">
                            <Authorized>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" @onclick="() => OpenEdit(n)">수정</button>
                                    <button class="btn btn-outline-danger" @onclick="() => DeleteNotice(n)">삭제</button>
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                    <small class="text-muted">@n.AuthorName · @n.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
                    <p class="card-text mt-2 mb-0" style="white-space: pre-wrap;">@n.Content</p>
                </div>
            </div>
        }
    }

    @* ---------- 비품 / 간식 요청 ---------- *@
    <hr class="my-4" />
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h4 class="mb-0">🧾 비품 / 간식 요청</h4>
        <button class="btn btn-outline-primary btn-sm" @onclick="OpenSupply">+ 요청하기</button>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr><th>신청일</th><th>신청자</th><th>분류</th><th>품목</th><th>수량</th><th>메모</th><th>상태</th></tr>
            </thead>
            <tbody>
                @if (supplies == null || supplies.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted">요청 내역이 없습니다.</td></tr>
                }
                else
                {
                    @foreach (var s in supplies)
                    {
                        <tr>
                            <td><small>@s.CreatedAt.ToLocalTime().ToString("MM-dd HH:mm")</small></td>
                            <td>@s.UserName</td>
                            <td>@s.Category</td>
                            <td>@s.ItemName</td>
                            <td>@s.Quantity</td>
                            <td><small>@s.Note</small></td>
                            <td>
                                <span class="badge @(s.Status switch { "승인" => "bg-success", "완료" => "bg-primary", "반려" => "bg-danger", _ => "bg-secondary" })">@s.Status</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* ---------- 비품/간식 요청 모달 ---------- *@
@if (supplyEditing != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">비품 / 간식 요청</h5>
                    <button type="button" class="btn-close" @onclick="() => supplyEditing = null"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">분류</label>
                        <select class="form-select" @bind="supplyEditing.Category">
                            <option value="비품">비품</option>
                            <option value="간식">간식</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">품목</label>
                        <input class="form-control" placeholder="예: A4용지, 커피믹스" @bind="supplyEditing.ItemName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">수량</label>
                        <input type="number" min="1" class="form-control" @bind="supplyEditing.Quantity" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">메모</label>
                        <input class="form-control" @bind="supplyEditing.Note" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => supplyEditing = null">취소</button>
                    <button class="btn btn-primary" @onclick="SaveSupply">요청</button>
                </div>
            </div>
        </div>
    </div>
}

@* ---------- 공지 작성/수정 모달 ---------- *@
@if (editing != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editing.Id == 0 ? "공지 작성" : "공지 수정")</h5>
                    <button type="button" class="btn-close" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">제목</label>
                        <input class="form-control" @bind="editing.Title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">내용</label>
                        <textarea class="form-control" rows="6" @bind="editing.Content"></textarea>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="pin" @bind="editing.IsPinned" />
                        <label class="form-check-label" for="pin">상단 고정</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cancel">취소</button>
                    <button class="btn btn-primary" @onclick="Save">저장</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Notice>? notices;
    private Notice? editing;
    private string? currentUserId;
    private string? currentUserName;

    private List<SupplyRequest>? supplies;
    private SupplyRequest? supplyEditing;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        currentUserId = principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        currentUserName = principal.FindFirst("KoreanName")?.Value ?? principal.Identity?.Name;
        await LoadNotices();
        await LoadSupplies();
    }

    private async Task LoadNotices()
    {
        notices = await Db.Notices
            .AsNoTracking()
            .OrderByDescending(n => n.IsPinned)
            .ThenByDescending(n => n.CreatedAt)
            .ToListAsync();
    }

    private async Task LoadSupplies()
    {
        supplies = await Db.SupplyRequests
            .AsNoTracking()
            .OrderByDescending(s => s.CreatedAt)
            .Take(50)
            .ToListAsync();
    }

    private void OpenSupply() => supplyEditing = new SupplyRequest { Quantity = 1, Category = "비품" };

    private async Task SaveSupply()
    {
        if (supplyEditing == null || string.IsNullOrWhiteSpace(supplyEditing.ItemName)) return;
        supplyEditing.UserId = currentUserId ?? "";
        supplyEditing.UserName = currentUserName;
        supplyEditing.Status = "대기";
        supplyEditing.CreatedAt = DateTime.UtcNow;
        Db.SupplyRequests.Add(supplyEditing);
        await Db.SaveChangesAsync();
        supplyEditing = null;
        await LoadSupplies();
    }

    private void OpenNew() => editing = new Notice();

    private void OpenEdit(Notice n) => editing = new Notice
    {
        Id = n.Id,
        Title = n.Title,
        Content = n.Content,
        IsPinned = n.IsPinned,
        AuthorId = n.AuthorId,
        AuthorName = n.AuthorName,
        CreatedAt = n.CreatedAt
    };

    private void Cancel() => editing = null;

    private async Task Save()
    {
        if (editing == null) return;
        if (string.IsNullOrWhiteSpace(editing.Title)) return;

        if (editing.Id == 0)
        {
            editing.AuthorId = currentUserId;
            editing.AuthorName = currentUserName;
            editing.CreatedAt = DateTime.UtcNow;
            editing.UpdatedAt = DateTime.UtcNow;
            Db.Notices.Add(editing);
        }
        else
        {
            var target = await Db.Notices.FindAsync(editing.Id);
            if (target != null)
            {
                target.Title = editing.Title;
                target.Content = editing.Content;
                target.IsPinned = editing.IsPinned;
                target.UpdatedAt = DateTime.UtcNow;
            }
        }
        await Db.SaveChangesAsync();
        editing = null;
        await LoadNotices();
    }

    private async Task DeleteNotice(Notice n)
    {
        var target = await Db.Notices.FindAsync(n.Id);
        if (target != null)
        {
            Db.Notices.Remove(target);
            await Db.SaveChangesAsync();
            await LoadNotices();
        }
    }
}
