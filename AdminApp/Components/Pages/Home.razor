@page "/"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject AdminApp.Services.EditableTextService Texts

<PageTitle>홈</PageTitle>

<div class="container-fluid py-3">
    <div class="row g-3">
        @* ================= 왼쪽: 공지사항 + 사내 문서함 ================= *@
        <div class="col-12 col-lg-6 d-flex flex-column gap-3">
            <div class="card shadow-sm border-0">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="mb-0 fs-4">@Texts.Get("home.notices.title")</h2>
                        <AuthorizeView Roles="Admin,Employee">
                            <Authorized>
                                <button class="btn btn-primary btn-sm" @onclick="OpenNew">+ 공지 작성</button>
                            </Authorized>
                        </AuthorizeView>
                    </div>

                    @if (notices == null)
                    {
                        <p>로딩 중...</p>
                    }
                    else if (notices.Count == 0)
                    {
                        <div class="text-center text-muted py-5 flex-grow-1">
                            <div class="fs-1">📭</div>
                            <p>등록된 공지사항이 없습니다.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush flex-grow-1">
                            @foreach (var n in PagedNotices)
                            {
                                <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0"
                                    style="cursor: pointer;" @onclick="() => GoToNotice(n.Id)">
                                    <span class="text-truncate me-2">
                                        @if (n.IsPinned)
                                        {
                                            <span class="badge bg-danger me-1">고정</span>
                                        }
                                        @AdminApp.Helpers.RecycleMarker.Strip(n.Title)
                                    </span>
                                    <small class="text-muted text-nowrap">@n.CreatedAt.ToLocalTime().ToString("MM-dd")</small>
                                </li>
                            }
                        </ul>

                        @if (TotalPages > 1)
                        {
                            <nav class="mt-3">
                                <ul class="pagination pagination-sm justify-content-center mb-0">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">‹</button>
                                    </li>
                                    @for (int p = 1; p <= TotalPages; p++)
                                    {
                                        var pageNum = p;
                                        <li class="page-item @(pageNum == currentPage ? "active" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                                        </li>
                                    }
                                    <li class="page-item @(currentPage == TotalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">›</button>
                                    </li>
                                </ul>
                            </nav>
                        }
                    }
                </div>
            </div>

            @* ----- 사내 문서함 (공지사항 아래) ----- *@
            <CompanyDocsPanel />
        </div>

        @* ================= 오른쪽: 사내 일정(캘린더) ================= *@
        <div class="col-12 col-lg-6">
            <h2 class="fs-4 mb-3">@Texts.Get("home.calendar.title")</h2>
            <CalendarPanel />
        </div>
    </div>

    @* ================= 하단: 에듀테크 동향 브리핑 ================= *@
    <hr class="my-4" />
    <InsightPanel />
</div>

@* ---------- 공지 작성 모달 ---------- *@
@if (editing != null)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1" @onclick="Cancel">
        <div class="modal-dialog modal-lg modal-dialog-centered" @onclick:stopPropagation="true" @onclick="NoOp">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">공지 작성</h5>
                    <button type="button" class="btn-close" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">제목</label>
                        <input class="form-control" @bind="editing.Title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">내용</label>
                        <textarea class="form-control" rows="6" @bind="editing.Content"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">첨부파일 <small class="text-muted">(파일당 최대 10MB, 최대 5개)</small></label>
                        <InputFile class="form-control" OnChange="OnFilesSelected" multiple />
                        @if (pendingFiles.Count > 0)
                        {
                            <ul class="list-group list-group-flush mt-2">
                                @foreach (var f in pendingFiles)
                                {
                                    <li class="list-group-item px-0 py-1 d-flex justify-content-between">
                                        <small>📎 @f.Name</small>
                                        <small class="text-muted">@FormatSize(f.Bytes.Length)</small>
                                    </li>
                                }
                            </ul>
                        }
                        @if (!string.IsNullOrEmpty(uploadError))
                        {
                            <div class="text-danger small mt-1">@uploadError</div>
                        }
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="pin" @bind="editing.IsPinned" />
                        <label class="form-check-label" for="pin">상단 고정</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="Cancel">취소</button>
                    <button class="btn btn-primary" @onclick="Save" disabled="@saving">@(saving ? "저장 중..." : "저장")</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Notice>? notices;
    private Notice? editing;
    private string? currentUserId;
    private string? currentUserName;

    // 페이징
    private const int pageSize = 5;
    private int currentPage = 1;
    private int TotalPages => notices == null ? 1 : Math.Max(1, (int)Math.Ceiling(notices.Count / (double)pageSize));
    private IEnumerable<Notice> PagedNotices =>
        (notices ?? new()).Skip((currentPage - 1) * pageSize).Take(pageSize);

    // 첨부파일 업로드
    private record PendingFile(string Name, string ContentType, byte[] Bytes);
    private readonly List<PendingFile> pendingFiles = new();
    private string? uploadError;
    private bool saving;
    private const long MaxFileSize = 10 * 1024 * 1024;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var principal = authState.User;
        currentUserId = principal.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        currentUserName = principal.FindFirst("KoreanName")?.Value ?? principal.Identity?.Name;
        await LoadNotices();
    }

    private async Task LoadNotices()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        notices = await db.Notices
            .AsNoTracking()
            .OrderByDescending(n => n.IsPinned)
            .ThenByDescending(n => n.CreatedAt)
            .ToListAsync();
        if (currentPage > TotalPages) currentPage = TotalPages;
    }

    private void GoToNotice(int id) => Nav.NavigateTo($"/notices/{id}");

    private void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        currentPage = page;
    }

    private void OpenNew()
    {
        editing = new Notice();
        pendingFiles.Clear();
        uploadError = null;
    }

    private void Cancel()
    {
        editing = null;
        pendingFiles.Clear();
        uploadError = null;
    }

    private void NoOp() { /* 모달 내부 클릭 propagation 차단 */ }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        uploadError = null;
        pendingFiles.Clear();
        foreach (var file in e.GetMultipleFiles(maximumFileCount: 5))
        {
            if (file.Size > MaxFileSize)
            {
                uploadError = $"'{file.Name}' 파일이 10MB를 초과합니다.";
                continue;
            }
            using var ms = new MemoryStream();
            await file.OpenReadStream(MaxFileSize).CopyToAsync(ms);
            pendingFiles.Add(new PendingFile(file.Name, file.ContentType, ms.ToArray()));
        }
    }

    private async Task Save()
    {
        if (editing == null || string.IsNullOrWhiteSpace(editing.Title)) return;
        saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            editing.AuthorId = currentUserId;
            editing.AuthorName = currentUserName;
            editing.CreatedAt = DateTime.UtcNow;
            editing.UpdatedAt = DateTime.UtcNow;
            db.Notices.Add(editing);
            await db.SaveChangesAsync();

            if (pendingFiles.Count > 0)
            {
                foreach (var f in pendingFiles)
                {
                    db.NoticeAttachments.Add(new NoticeAttachment
                    {
                        NoticeId = editing.Id,
                        FileName = f.Name,
                        ContentType = f.ContentType,
                        Size = f.Bytes.Length,
                        Content = f.Bytes,
                        CreatedAt = DateTime.UtcNow
                    });
                }
                await db.SaveChangesAsync();
            }
        }
        finally
        {
            saving = false;
        }
        editing = null;
        pendingFiles.Clear();
        currentPage = 1;
        await LoadNotices();
    }

    private static string FormatSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B"
        : bytes < 1024 * 1024 ? $"{bytes / 1024.0:0.#} KB"
        : $"{bytes / (1024.0 * 1024):0.#} MB";
}
