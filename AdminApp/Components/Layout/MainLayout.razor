@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView Roles="Admin,Employee">
                <a class="btn btn-primary btn-sm" href="/pm-launch" target="_blank" rel="noopener" data-enhance-nav="false">
                    프로젝트 관리
                </a>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@* 푸시 알림 권한 안내 토스트 (로그인 상태에서만) *@
<PushSubscribeButton />
